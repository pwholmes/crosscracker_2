# Copy this file to .env and fill in secrets.
# cp .env.example .env

# ============================================================================
# NYT Crossword API Configuration
# ============================================================================
# This value is used by the get_nyt_puzzle.py script to retrieve a crossword
# from the New York Times website and create a properly formatted source file
# out of it that the app can use.  Just run the script and voila, a new puzzle 
# is available for the app to solve.  You need a subsription to NYT Puzzles to 
# get this key, but it's less than $2/month.  Treat yourself!  Read the script 
# file for more info.
NYT_S_COOKIE=

# ============================================================================
# HuggingFace Configuration
# ============================================================================
# This value is used by the load_dataset.py script to download the "hint"
# dataset and inject it into your local ChromaDB database.  WARNING: It's
# a BIG dataset (6.7 million rows) and takes a LONG time to add to the
# database.  It's not the download that takes long, it's the database API.
# It took me about 6 hours.  You've been warned!  The key itself is free,
# though.  You just need a HuggingFace account.
HF_TOKEN=

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Choose LLM provider: ollama or claude
LLM_PROVIDER=ollama

# --- Ollama Configuration ---
OLLAMA_URL=http://localhost:11434/api/generate
# You can use any Ollama model you like.  llama3.1:8b is probably about the best 
# you'll ever see for something that runs in 6-8 GB of RAM.  Yes, there are 
# better Ollama LLMs, but for an LLM, better = bigger.
OLLAMA_MODEL=llama3.1:8b
# Alternative Ollama models:
#OLLAMA_MODEL=qwen2.5-coder:14b
#OLLAMA_MODEL=claude3:7b

# --- Claude Configuration ---
# Anthropic Claude API key (required if LLM_PROVIDER=claude)
# Get your API key from: https://console.anthropic.com
CLAUDE_API_KEY=

# Claude model to use (optional, defaults to claude-haiku-4-5)
# Available models as of 2026-03-10: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5
# Haiku costs $1/input Mtok and $5/output Mtok, Sonnet is $3/$15, and Opus is $5/$25.
# To give an idea of the costs, two executions of the Daybreak puzzle (28 clues) with the 
# Haiku LLM cost $0.11.  Initializing an NYT puzzle (78 clues) cost another $0.06, and 
# solving from there cost another $0.13, for a total of $0.19.  But Haiku provided a
# low-quality solution: 11 backtracks, 9 fallbacks, 4 incorrect answers.
# With the state-of-the-art Opus 4.6 model, that puzzle cost $0.13 to initialize and
# $0.28 to solve from there, for a total of $0.41.  But it solved it perfectly on the 
# first try, with very high confidence for almost every answer.
CLAUDE_MODEL=claude-haiku-4-5

# ============================================================================
# LLM Generation Tunables
# ============================================================================
LLM_MAX_SEARCH_LEVEL=2
LLM_DEFAULT_CONFIDENCE=30.0
LLM_MAX_CANDIDATES=[7, 12, 15]

OLLAMA_GENERATION_LEVEL_0_TEMPERATURE=0.25
OLLAMA_GENERATION_LEVEL_0_TOP_P=0.8
OLLAMA_GENERATION_LEVEL_0_TOP_K=10
OLLAMA_GENERATION_LEVEL_1_TEMPERATURE=0.7
OLLAMA_GENERATION_LEVEL_1_TOP_P=0.9
OLLAMA_GENERATION_LEVEL_1_TOP_K=30
OLLAMA_GENERATION_LEVEL_2_TEMPERATURE=1.0
OLLAMA_GENERATION_LEVEL_2_TOP_P=0.95
OLLAMA_GENERATION_LEVEL_2_TOP_K=60
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TOP_LOGPROBS=5

CLAUDE_GENERATION_LEVEL_0_TEMPERATURE=0.25
CLAUDE_GENERATION_LEVEL_0_TOP_K=10
CLAUDE_GENERATION_LEVEL_1_TEMPERATURE=0.7
CLAUDE_GENERATION_LEVEL_1_TOP_K=30
CLAUDE_GENERATION_LEVEL_2_TEMPERATURE=1.0
CLAUDE_GENERATION_LEVEL_2_TOP_K=60

# ============================================================================
# Candidate Tunables
# ============================================================================
# These values tune heuristics specifically related to candidate answers.

# These are relative weights assigned to the candidate's confidence levels.
# One is provided by whatever LLM you're using in response to the prompt we feed it.
# The other is for Ollama only, and is derived from the "logprobs", which are 
# probability values returned by the API for each token it returns.
# Confidewnce values not assigned are ignored (as opposed to being treated as
# if they had a value of 0).
# The two weights should sum to 1.0.
CANDIDATE_LLM_CONFIDENCE_WEIGHT=0.6
CANDIDATE_LOGPROB_CONFIDENCE_WEIGHT=0.4

# The confidence penalties assigned to a candidate answer under sifferent conditions.
# One is when the answer is backtracked, and the other is when we decide
# not to place an entry because a crossing entry fails to verify.
# Note that we never discard a candidate, even if we backtrack it, because it
# may turn out to be the correct answer after all.
CANDIDATE_BACKTRACK_PENALTY=25
CANDIDATE_VERIFICATION_PENALTY=5

# The minimum confidence level for a candidate to be considered for placement.
# Penalties can never decrease confidence below this level.
CANDIDATE_MIN_SELECTABLE_CONFIDENCE=25

# ============================================================================
# Heuristics Tunables
# ============================================================================
# These values tune heuristics related to how the solver selects entries for
# placement, backtrack, and fallback.  Well, actually there are no tuneables
# for the backtrack heuristics.  That's just a complicated algorithm with no 
# weights.  If you're curious, it basically selects entries based on whether
# they block high-confidence crossing entries.

# The relative weights of the factors used to select which entry to place.
# They should sum to 1.0.
# This one weighs the candidate's confidence level.  Higher is better.
HEURISTICS_SELECTION_CONFIDENCE_WEIGHT=0.25
# This one weighs the entry's length.  Longer is better.
HEURISTICS_SELECTION_LENGTH_WEIGHT=0.2
# The one weighs how "filled in" the entry is.  More filled in is better.
HEURISTICS_SELECTION_COMPLETENESS_WEIGHT=0.35
# This one weighs the number of candidates the entry has.  Fewer is better
# (though I'll admit that whether this is actually true is debatable).
HEURISTICS_SELECTION_CONSTRAINT_WEIGHT=0.2

# The relative weights of the factors used to select an entry to backtrack.
# They should sum to 1.0.
# This one weighs how "filled in" the entry is.  Less filled in is better.
HEURISTICS_FALLBACK_COMPLETENESS_WEIGHT=0.5
# This one weighs the confidence of the entry's highest-confidence candidate.  
# Lower is better.
HEURISTICS_FALLBACK_CONFIDENCE_WEIGHT=0.3
# This one weighs how many times this entry has been backtracked before.  
# More is better.
HEURISTICS_FALLBACK_BACKTRACKS_WEIGHT=0.2

# ============================================================================
# Solver Tunables
# ============================================================================
SOLVER_MAX_BACKTRACKS_BEFORE_FALLBACK=3

# ============================================================================
# Vector DB Tunables
# ============================================================================
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=crossword_1
CHROMA_EXECUTION_PROVIDER=CUDAExecutionProvider

# ============================================================================
# Server Tunables
# ============================================================================
SERVER_PLAY_INTERVAL_SECONDS=0
RECORDINGS_DIR=/absolute/path/to/your/repo/backend/recordings
CHECKPOINTS_DIR=/absolute/path/to/your/repo/backend/checkpoints
FRONTEND_DIR=/absolute/path/to/your/repo/frontend
